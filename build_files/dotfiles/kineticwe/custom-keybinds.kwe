# KineticWE custom keybinds — generated by Kinetic Settings.
# Each entry adds one action to the Applications / Custom Commands
# keybinds categories; chords live in keybinds.kwe and the daemon.
[applications]
kitty=kitty
org.mozilla.firefox=Firefox
nemo=Archivos
org.kde.spectacle=Spectacle
[applications:exec]
kitty=kitty
org.mozilla.firefox=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=firefox --file-forwarding org.mozilla.firefox @@u  @@
nemo=nemo
org.kde.spectacle=/usr/bin/spectacle
